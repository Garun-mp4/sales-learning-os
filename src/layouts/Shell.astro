---
import '../styles/tailwind.css';
import { modules, stages } from '../lib/course';
import Icon from '../components/Icon.astro';
interface Props { title: string; active?: string; module?: string; documentId?: string; documentKind?: string; libraryId?: string; reading?: boolean }
const {title, active, module, documentId, documentKind, libraryId, reading=false}=Astro.props;
const pathname = Astro.url.pathname;
const currentSection = active ?? (
  pathname === '/' ? 'home' :
  /^\/(?:roadmap|level|module|lesson)\//.test(pathname) ? 'roadmap' :
  /^\/(?:practice|final-project)\//.test(pathname) ? 'practice' :
  /^\/(?:sources|source)\//.test(pathname) ? 'sources' :
  /^\/library\//.test(pathname) ? 'library' :
  /^\/(?:search|bookmarks|settings)\//.test(pathname) ? pathname.split('/')[1] :
  undefined
);
---
<!DOCTYPE html>
<html lang="ru" data-root="/">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content="Sales OS — изучение продаж через проверяемую теорию, практику и собственные проекты."/>
  <meta name="theme-color" content="#ffffff" data-theme-color/>
  <title>{title} · Sales OS</title>
  <link rel="icon" type="image/png" href="/assets/brand/favicon-light.png" sizes="32x32" media="(prefers-color-scheme: light)"/>
  <link rel="icon" type="image/png" href="/assets/brand/favicon-dark.png" sizes="32x32" media="(prefers-color-scheme: dark)"/>
  <link rel="apple-touch-icon" href="/assets/brand/app-icon-192.png"/>
  <link rel="manifest" href="/manifest.webmanifest"/>
  <link rel="preload" href="/assets/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin/>
  <link rel="stylesheet" href="/assets/app.css"/>
  <noscript><style>@media(max-width:768px){.app{display:block}.side{position:static;top:auto;width:auto;height:auto;transform:none;overflow:visible;visibility:visible}.side-close,.menu-toggle,.mobile-shade{display:none!important}}</style></noscript>
  <script is:inline>
    try {const s=localStorage.getItem('sales-os-theme')||'system';const dark=s==='dark'||s==='system'&&matchMedia('(prefers-color-scheme:dark)').matches;document.documentElement.dataset.theme=dark?'dark':'light';document.documentElement.style.colorScheme=dark?'dark':'light';document.querySelector('[data-theme-color]').content=dark?'#000000':'#ffffff'} catch {}
  </script>
</head>
<body data-doc-id={documentId} data-doc-kind={documentKind} data-library-id={libraryId}>
  <a class="skip" href="#main">К основному содержимому</a>
  <div class="mobile-shade" aria-hidden="true"></div>
  <div class="app">
    <aside class="side" id="side-navigation" aria-label="Навигация по Sales OS" tabindex="-1">
      <div class="side-top"><a class="brand-lockup" href="/" aria-label="Sales OS — на главную"><img class="brand-logo brand-logo-light" src="/assets/brand/logo-light.png" alt="" width="1361" height="754"/><img class="brand-logo brand-logo-dark" src="/assets/brand/logo-dark.png" alt="" width="1361" height="754"/><img class="brand-symbol brand-symbol-light" src="/assets/brand/mark-light.png" alt="" width="512" height="512"/><img class="brand-symbol brand-symbol-dark" src="/assets/brand/mark-dark.png" alt="" width="512" height="512"/></a><span class="version">2.0</span><button class="iconbtn side-close" type="button" data-menu-close aria-label="Закрыть меню">×</button></div>
      <nav class="side-body" aria-label="Главное меню">
        <div class="nav-caption">Рабочая область</div>
        <a class:list={['nav-item',currentSection==='home'&&'active']} href="/" aria-label="Обзор" aria-current={currentSection==='home'?'page':undefined} title="Обзор"><Icon name="home"/><span>Обзор</span></a>
        <a class:list={['nav-item',currentSection==='roadmap'&&'active']} href="/roadmap/" aria-label="Roadmap" aria-current={currentSection==='roadmap'?'page':undefined} title="Roadmap"><Icon name="map"/><span>Roadmap</span></a>
        <a class:list={['nav-item',currentSection==='practice'&&'active']} href="/practice/" aria-label="Практика" aria-current={currentSection==='practice'?'page':undefined} title="Практика"><Icon name="practice"/><span>Практика</span></a>
        <a class:list={['nav-item',currentSection==='search'&&'active']} href="/search/" aria-label="Поиск" aria-current={currentSection==='search'?'page':undefined} title="Поиск"><Icon name="search"/><span>Поиск</span></a>
        <a class:list={['nav-item',currentSection==='sources'&&'active']} href="/sources/" aria-label="Источники" aria-current={currentSection==='sources'?'page':undefined} title="Источники"><Icon name="library"/><span>Источники</span></a>
        <a class:list={['nav-item',currentSection==='library'&&'active']} href="/library/" aria-label="Справочные материалы" aria-current={currentSection==='library'?'page':undefined} title="Справочные материалы"><Icon name="book"/><span>Справочники</span></a>
        <a class:list={['nav-item',currentSection==='bookmarks'&&'active']} href="/bookmarks/" aria-label="Закладки" aria-current={currentSection==='bookmarks'?'page':undefined} title="Закладки"><Icon name="star"/><span>Закладки</span></a>
        <div class="nav-caption">Программа · 4 уровня</div>
        {stages.map(s=><details class="nav-group" open={modules.some(m=>m.module===module&&m.stage===s.id)||s.id===1}>
          <summary><span class="num">{String(s.id).padStart(2,'0')}</span><span>{s.title}</span><span class="arr">›</span></summary>
          <div class="nav-sub">{modules.filter(m=>m.stage===s.id).map(m=><a class:list={['nav-item',m.module===module&&'active']} href={`/module/${m.id}/`} aria-label={`${m.module} · ${m.title}`} aria-current={m.module===module?(pathname===`/module/${m.id}/`?'page':'location'):undefined} title={m.title}><span class="label-number">{m.module}</span><span>{m.title}</span></a>)}</div>
        </details>)}
      </nav>
      <div class="side-foot">Общий прогресс <span data-global-pct>0%</span><div class="progress tiny-track" role="progressbar" aria-label="Общий прогресс обучения" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-global-progress><span data-global-fill></span></div></div>
    </aside>
    <div class="main-wrap" data-drawer-background>
      <header class="topbar">
        <button class="iconbtn menu-toggle" type="button" data-menu-toggle aria-controls="side-navigation" aria-expanded="false" aria-label="Открыть меню"><Icon name="menu"/></button>
        <a class="brand-compact" href="/" aria-label="На главную Sales OS"><img class="brand-symbol brand-symbol-light" src="/assets/brand/mark-light.png" alt="" width="512" height="512"/><img class="brand-symbol brand-symbol-dark" src="/assets/brand/mark-dark.png" alt="" width="512" height="512"/><span>Sales OS</span></a>
        <span class="spacer"></span>
        <a class="toplink" href="/search/" aria-label="Поиск"><Icon name="search"/><span>Поиск</span><span class="search-shortcut">/</span></a>
        <select class="theme-switch" data-theme-select aria-label="Цветовая тема"><option value="system">Системная</option><option value="light">Светлая</option><option value="dark">Тёмная</option></select>
        <a class="iconbtn" href="/settings/" title="Настройки" aria-label="Настройки" aria-current={currentSection==='settings'?'page':undefined}><Icon name="settings"/></a>
      </header>
      <main id="main" tabindex="-1" class:list={['container',reading&&'reading-layout']}>
        <slot />
        <footer class="footer"><span>SALES OS / KNOWLEDGE BASE · 2026</span><span>Прогресс остаётся на устройстве · Материалы: редакционный черновик</span></footer>
      </main>
    </div>
  </div>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script src="/assets/user-store.js" defer is:inline></script>
  <script src="/assets/app.js" defer is:inline></script>
</body>
</html>
