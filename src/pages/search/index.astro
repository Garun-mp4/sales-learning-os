---
import Shell from '../../layouts/Shell.astro';import PageHeading from '../../components/PageHeading.astro';
---
<Shell title="Поиск" active="search"><nav class="breadcrumb" aria-label="Хлебные крошки"><a href="/">Обзор</a> › <span aria-current="page">Поиск</span></nav>
<PageHeading eyebrow="ПОИСК ПО КУРСУ" title="Найти материал" description="Полнотекстовый поиск по материалам уроков, практики и модулей."/>
<label class="small muted" for="search-input">Поисковый запрос</label><input class="search-field" id="search-input" name="q" type="search" data-search-input autocomplete="off" placeholder="Например, возражения, SPIN, обмен ценностью"/>
<div class="notice search-status" data-search-status role="status" aria-live="polite" aria-atomic="true" aria-busy="true">Загрузка поиска…</div><div class="stack" style="margin-top:24px" data-search-results role="region" aria-label="Результаты поиска" aria-busy="true"></div></Shell>
