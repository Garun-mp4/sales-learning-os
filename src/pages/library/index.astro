---
import PageHeading from '../../components/PageHeading.astro';
import Shell from '../../layouts/Shell.astro';
import { libraries } from '../../lib/course';
---

<Shell title="Справочники" description="Глоссарий, учебные ситуации и шаблоны для работы с материалами курса продаж." active="library">
  <nav class="breadcrumb" aria-label="Хлебные крошки"><a href="/">Обзор</a> › <span aria-current="page">Справочники</span></nav>
  <PageHeading eyebrow="СПРАВОЧНЫЕ МАТЕРИАЛЫ" title="Библиотека курса" description="Термины, учебные ситуации и рабочие заготовки — рядом с учебным маршрутом и поиском." />
  <div class="library-card-grid">
    {libraries.map((library) => (
      <a class="card library-card" href={`/library/${library.id}/`}>
        <span class="badge">Справочник</span>
        <h2>{library.title}</h2>
        <p>{library.description}</p>
        <span class="small muted">Открыть →</span>
      </a>
    ))}
  </div>
  <section class="notice editorial-notice" aria-labelledby="editorial-readiness-title">
    <div><strong id="editorial-readiness-title">Редакторская готовность курса</strong><p>Все 430 основных документов пока имеют статус редакционного черновика. Это можно проверить по материалам и связанным источникам.</p></div>
    <a class="btn smallbtn" href="/editorial-review/">Открыть карту проверки →</a>
  </section>
</Shell>
