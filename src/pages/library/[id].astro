---
import { getCollection, render } from 'astro:content';
import PageHeading from '../../components/PageHeading.astro';
import Shell from '../../layouts/Shell.astro';
import { libraries } from '../../lib/course';
import templateManager from '../../generated/template-manager.html?raw';

export async function getStaticPaths() {
  const documents = await getCollection('libraries');
  return documents.map((doc) => ({ params: { id: doc.data.id }, props: { doc } }));
}

const { doc } = Astro.props;
const library = libraries.find((item) => item.id === doc.data.id);
if (!library) throw new Error(`Unknown library: ${doc.data.id}`);
const { Content } = await render(doc);
---

<Shell title={library.title} description={library.description} active="library" libraryId={library.id} reading>
  <nav class="breadcrumb" aria-label="Хлебные крошки"><a href="/">Обзор</a> › <a href="/library/">Справочники</a> › <span aria-current="page">{library.title}</span></nav>
  <PageHeading eyebrow="СПРАВОЧНЫЙ МАТЕРИАЛ · РЕДАКЦИОННЫЙ ЧЕРНОВИК" title={library.title} description={library.description} />
  {library.id === 'templates' && <div set:html={templateManager}></div>}
  <article class="article library-content prose" data-pagefind-body data-search-id={library.id} data-library-id={library.id} data-search-level="extra" data-search-module="extra" data-search-kind="library" data-pagefind-filter="level[data-search-level], module[data-search-module], kind[data-search-kind]" data-pagefind-meta="id[data-search-id], level[data-search-level], module[data-search-module], kind[data-search-kind]" data-library-updated={library.id === 'templates' ? doc.data.updated : undefined} data-template-copy={library.id === 'templates' ? '' : undefined}>
    <Content />
  </article>
  <a class="btn" href="/library/">← Ко всем справочникам</a>
</Shell>
