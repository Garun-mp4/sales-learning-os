---
import Shell from '../../layouts/Shell.astro';import PageHeading from '../../components/PageHeading.astro';import EntryRow from '../../components/EntryRow.astro';import {practices,modules} from '../../lib/course';
---
<Shell title="Практика" description="72 задания, связанные с реальными задачами продажи сайтов и IT-услуг. Ответы и самооценка хранятся локально." active="practice"><nav class="breadcrumb" aria-label="Хлебные крошки"><a href="/">Обзор</a> › <span aria-current="page">Практика</span></nav>
<PageHeading eyebrow="ПРИМЕНЕНИЕ ЗНАНИЙ" title="Практические задания" description="72 упражнения, связанные с реальными задачами продажи сайтов и IT-услуг. Ответы сохраняются локально."/>
<section class="notice project-callout" aria-labelledby="practice-project-title"><h2 id="practice-project-title">Сквозной итоговый проект</h2><p>Соберите путь от выбора ниши и исследования клиентов до оффера, переговоров и ретроспективы. Если реальной сделки пока нет, проект можно пройти как учебную симуляцию.</p><a class="btn smallbtn" href="/final-project/">Открыть итоговый проект →</a></section>
<div class="filter-row"><label>Модуль <select data-filter="module"><option value="">Все модули</option>{modules.map(m=><option value={m.module}>{m.module} · {m.title}</option>)}</select></label><label>Категория изучения <select data-filter="level"><option value="">Любой</option><option value="required">Обязательные</option><option value="advanced">Продвинутые</option></select></label><span class="badge" role="status" aria-live="polite">Показано <span data-filter-count>72</span> из {practices.length} заданий</span></div>
<div class="notice" data-filter-empty hidden>По выбранным фильтрам заданий нет. <button class="btn smallbtn" type="button" data-filter-reset>Сбросить фильтры</button></div>
<div class="stack">{practices.map(e=><div data-filter-item data-mod={e.module} data-level={e.level}><EntryRow entry={e}/></div>)}</div></Shell>
