---
import Shell from '../../layouts/Shell.astro';import PageHeading from '../../components/PageHeading.astro';import EntryRow from '../../components/EntryRow.astro';import {practices,modules} from '../../lib/course';
---
<Shell title="Практика" active="practice"><div class="breadcrumb"><a href="/">Обзор</a> › <span>Практика</span></div>
<PageHeading eyebrow="ПРИМЕНЕНИЕ ЗНАНИЙ" title="Практические задания" description="72 упражнения, связанные с реальными задачами продажи сайтов и IT-услуг. Ответы сохраняются локально."/>
<div class="filter-row"><label>Модуль <select data-filter="module"><option value="">Все модули</option>{modules.map(m=><option value={m.module}>{m.module} · {m.title}</option>)}</select></label><label>Уровень <select data-filter="level"><option value="">Любой</option><option value="required">Обязательные</option><option value="advanced">Продвинутые</option></select></label><span class="badge"><span data-filter-count>72</span> заданий</span></div>
<div class="stack">{practices.map(e=><div data-filter-item data-mod={e.module} data-level={e.level}><EntryRow entry={e}/></div>)}</div></Shell>
