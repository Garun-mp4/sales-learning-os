---
import {sourceTypeLabels} from '../../lib/ui-copy';
import Shell from '../../layouts/Shell.astro';import PageHeading from '../../components/PageHeading.astro';import EntryRow from '../../components/EntryRow.astro';import {sources,lessons} from '../../lib/course';
export function getStaticPaths(){return sources.map(source=>({params:{id:source.id},props:{source}}));}
const {source}=Astro.props;const linked=lessons.filter(e=>e.sources.includes(source.id));
const isValidLink=(()=>{try{return ['https:','http:'].includes(new URL(source.url).protocol)}catch{return false}})();
---
<Shell title={source.title} description={`${source.author}. ${source.description || source.author}`} active="sources"><nav class="breadcrumb" aria-label="Хлебные крошки"><a href="/sources/">Источники</a> › <span aria-current="page">{source.id}</span></nav>
<PageHeading eyebrow={`ИСТОЧНИК · ${source.id}`} title={source.title} description={source.author}/>
<div class="notice">Описание и ссылка перенесены из каталога курса. Независимое ознакомление с полным содержанием источника не заявляется.</div><article class="article source-content" data-pagefind-body data-search-id={source.id} data-search-level="extra" data-search-module="extra" data-search-kind="source" data-pagefind-filter="level[data-search-level], module[data-search-module], kind[data-search-kind]" data-pagefind-meta="id[data-search-id], level[data-search-level], module[data-search-module], kind[data-search-kind]"><p class="small muted">{source.author} · {sourceTypeLabels[source.type]||'Источник'}</p><p class="intro">{source.description}</p></article>
{isValidLink&&<p><a class="btn primary" href={source.url} target="_blank" rel="noopener noreferrer">Открыть первоисточник ↗</a></p>}
<div class="section-head"><h2 class="h2">Связанные уроки</h2><span class="badge">{linked.length}</span></div><div class="stack">{linked.slice(0,80).map(e=><EntryRow entry={e}/>)}</div>
{linked.length>80&&<p class="pill-note">Показаны первые 80 уроков.</p>}
</Shell>
