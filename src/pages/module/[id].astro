---
import Shell from '../../layouts/Shell.astro';
import PageHeading from '../../components/PageHeading.astro';
import EntryRow from '../../components/EntryRow.astro';
import {quantity} from '../../lib/ui-copy';
import { getCollection, render } from 'astro:content';
import { modules, ofModule, stages, href } from '../../lib/course';
export async function getStaticPaths(){return modules.map(entry=>({params:{id:entry.id},props:{entry}}));}
const {entry}=Astro.props;
const docs=ofModule(entry.module);const theory=docs.filter(x=>x.kind==='theory');const practice=docs.filter(x=>x.kind==='practice');
const groups=[...new Set(theory.map(x=>x.group))];const stage=stages.find(x=>x.id===entry.stage);
const moduleDocs=await getCollection('documents',doc=>doc.data.id===entry.id&&doc.data.kind==='module');
if(moduleDocs.length!==1)throw new Error(`Expected one integration chapter for ${entry.id}`);
const {Content}=await render(moduleDocs[0]);
---
<Shell title={entry.title} description={entry.description} module={entry.module}>
  <nav class="breadcrumb" aria-label="Хлебные крошки"><a href="/roadmap/">Roadmap</a> › <a href={`/level/${entry.stage}/`}>{stage?.title}</a> › <span aria-current="page">{entry.title}</span></nav>
  <PageHeading eyebrow={`МОДУЛЬ ${entry.module} · УРОВЕНЬ ${entry.stage}`} title={entry.title} description={entry.description}>
    <div class="row wrap"><span class="badge warning">Редакционный черновик</span><span class="badge">{quantity(theory.length,['тема','темы','тем'])}</span><span class="badge">{quantity(practice.length,['практика','практики','практик'])}</span><span class="badge">{entry.time}</span></div>
  </PageHeading>
<div class="module-summary"><strong>Результат изучения</strong><p>{entry.outcome}</p><div class="progress" style="margin-top:14px" role="progressbar" aria-label={`Прогресс модуля ${entry.module}`} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="0%" data-module-progress={entry.module}><span data-module-fill={entry.module}></span></div><p data-module-pct={entry.module}>0%</p></div>
  <nav class="module-actions" aria-label="Действия модуля"><a class="btn primary" data-module-continue={entry.module} href={href(theory[0]||practice[0])}>Начать модуль</a><a class="btn" href="#module-theory">Теория</a><a class="btn" href="#module-practice">Практика</a><a class="btn" href="#module-overview">Обзор</a></nav>
  <article id="module-overview" class="article module-reading prose" data-pagefind-body data-search-id={entry.id} data-search-level={entry.level} data-search-module={entry.module} data-search-kind="module" data-pagefind-filter="level[data-search-level], module[data-search-module], kind[data-search-kind]" data-pagefind-meta="id[data-search-id], level[data-search-level], module[data-search-module], kind[data-search-kind]"><Content /></article>
  <div class="section-head"><h2 class="h2" id="module-theory">Теория</h2><span class="small muted">По порядку, от основ к практике</span></div>
  {groups.map(group=><section class="module-section"><h2>{group} <span class="badge">{theory.filter(x=>x.group===group).length}</span></h2><div class="stack">{theory.filter(x=>x.group===group).map(x=><EntryRow entry={x}/>)}</div></section>)}
  <div class="section-head"><h2 class="h2" id="module-practice">Практика</h2></div><div class="stack">{practice.map(x=><EntryRow entry={x}/>)}</div>
  <div class="editbox"><strong>Заметки по модулю</strong><textarea data-note={`${entry.module}-MODULE`} aria-label="Заметки к модулю" placeholder="Ваши выводы по модулю..."></textarea><div class="hint" data-save-hint>Локальное сохранение</div></div>
</Shell>
