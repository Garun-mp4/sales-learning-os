---
import { render, type CollectionEntry } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import PageHeading from './PageHeading.astro';
import EntryRow from './EntryRow.astro';
import PracticeWorkspace from './PracticeWorkspace.astro';
import StatusControl from './StatusControl.astro';
import Icon from './Icon.astro';
import {studyLabel} from '../lib/ui-copy';
import { entries,href,neighbor,relatedLibraries,sources } from '../lib/course';
import { parsePracticeRubric } from '../lib/practice-rubric.mjs';
interface Props { doc:CollectionEntry<'documents'> }
const {doc}=Astro.props;const d=doc.data;const e=entries[d.id];
if(!e||e.kind!==d.kind)throw Error(`Unknown learning document: ${d.id}`);
const {Content,headings}=await render(doc);
const related=d.related_practice.map(id=>entries[id]).filter(Boolean);
const references=relatedLibraries(e);
const {previous,next}=neighbor(e);
const isPractice=d.kind==='practice';
const practiceRubric=isPractice?parsePracticeRubric(doc.body):[];
if(isPractice&&practiceRubric.length<3)throw Error(`Practice rubric missing for ${d.id}`);
const tocHeadings=[...headings.filter(h=>h.depth===2||h.depth===3),...(isPractice?[{depth:2,slug:`workspace-${d.id}`,text:'Мой ответ'},{depth:2,slug:`history-${d.id}`,text:'История итераций'}]:[])];
---
<Shell title={d.title} description={`${d.title} — ${isPractice?'практическое задание':'учебный материал'} модуля ${d.module}, ${d.group.toLowerCase()}. Самопроверка и ответы сохраняются на устройстве.`} module={d.module} documentId={d.id} documentKind={d.kind} reading>
  <nav class="breadcrumb" aria-label="Хлебные крошки"><a href="/roadmap/">Roadmap</a> › <a href={`/module/${d.module}-MODULE/`}>Модуль {d.module}</a> › <span aria-current="page">{d.id}</span></nav>
  <PageHeading eyebrow={`${isPractice?'ПРАКТИЧЕСКОЕ ЗАДАНИЕ':'УЧЕБНЫЙ МАТЕРИАЛ'} · ${d.id}`} title={d.title}>
    <div class="row wrap"><span class="badge warning">Редакционный черновик</span><span class="badge">{d.group}</span><span class="badge">{studyLabel(d.kind,d.level)}</span></div>
  </PageHeading>
  <div class="reading-controls">
    <StatusControl id={d.id} kind={d.kind}/>
    <button type="button" class="btn smallbtn" data-bookmark={d.id} aria-pressed="false"><Icon name="star"/><span data-bookmark-label>В закладки</span></button>
    <a class="btn smallbtn" href={`/module/${d.module}-MODULE/`}>К модулю</a>
    <details class="revisit-schedule"><summary class="btn smallbtn">Вернуться позже</summary><div class="revisit-popover"><label for={`revisit-delay-${d.id}`}>Показать снова</label><select id={`revisit-delay-${d.id}`} data-revisit-delay={d.id}><option value="1">Завтра</option><option value="3">Через 3 дня</option><option value="7">Через неделю</option></select><button type="button" class="btn smallbtn" data-revisit-add={d.id} data-revisit-title={d.title}>Добавить в очередь</button><p class="small muted" data-revisit-status={d.id} role="status" aria-live="polite"></p></div></details>
    {isPractice&&<a class="btn primary" href={`#workspace-${d.id}`}>Перейти к ответу</a>}
  </div>
  {tocHeadings.length>0&&<details class="toc-disclosure"><summary>Содержание материала<Icon name="chevron-down"/></summary><nav class="toc" aria-label="Содержание материала">{tocHeadings.map(h=><a class={h.depth===3?'depth3':'depth2'} href={`#${h.slug}`}>{h.text}</a>)}</nav></details>}
  <div class="reader-grid"><div class="reader">
    <article class="article" data-pagefind-body data-search-id={d.id} data-search-level={d.level} data-search-module={d.module} data-search-kind={d.kind} data-pagefind-filter="level[data-search-level], module[data-search-module], kind[data-search-kind]" data-pagefind-meta="id[data-search-id], level[data-search-level], module[data-search-module], kind[data-search-kind]"><Content /></article>
    {references.length>0&&<section class="library-references" aria-labelledby="related-library-title"><div class="section-head"><h2 class="h2" id="related-library-title">Справка по теме</h2></div><div class="library-reference-list">{references.map(reference=><a class="library-reference" href={`/library/${reference.id}/`}><span class="badge">Справочник</span><strong>{reference.title}</strong><span class="small muted">Открыть →</span></a>)}</div></section>}
    <div class="source-chips">{d.sources.filter(id=>sources.some(s=>s.id===id)).map(id=><a class="badge" href={`/source/${id}/`}>{id} · источник</a>)}</div>
    {!isPractice&&related.length>0&&<section class="module-section"><h2 class="h2">Связанная практика</h2><div class="stack">{related.map(x=><EntryRow entry={x}/>)}</div></section>}
    {isPractice&&<div class="notice">Самопроверка помогает выбрать следующую итерацию, но не выставляет итоговую оценку и не является независимой аттестацией.</div>}
    {isPractice&&<PracticeWorkspace id={d.id} title={d.title} rubric={practiceRubric}/>}
    <div class="editbox"><strong>{isPractice?'Дополнительная заметка к заданию':'Мои заметки по теме'}</strong><p class="hint">Сохраняется только на устройстве. Не публикуйте персональные данные заказчиков.</p><textarea data-note={d.id} aria-label={isPractice?'Дополнительная заметка к заданию':'Заметки по уроку'} placeholder="Ваши выводы, ответ или ссылка на рабочий документ..."></textarea><div class="hint" data-save-hint>Загрузка заметки…</div></div>
    <div class="reading-completion"><strong>Завершение материала</strong><StatusControl id={d.id} kind={d.kind} suffix="bottom"/></div>
    <nav class="navprevnext" aria-label="Соседние материалы">
      {previous&&<a href={href(previous)}>← Предыдущий материал<strong>{previous.title}</strong></a>}
      {next&&<a href={href(next)}>Следующий материал →<strong>{next.title}</strong></a>}
    </nav>
  </div><aside class="reader-aside"><h3>В этом материале</h3><nav class="toc">{tocHeadings.map(h=><a class={h.depth===3?'depth3':'depth2'} href={`#${h.slug}`}>{h.text}</a>)}</nav></aside></div>
</Shell>
