<div class="stat-grid" role="group" aria-label="Прогресс обучения">
  <div class="stat">
    <div class="label">Пройдено теории</div>
    <div class="value" data-global-theory>0 / 336</div>
    <div class="label">336 уроков</div>
  </div>
  <div class="stat">
    <div class="label">Практика</div>
    <div class="value" data-global-practice>0 / 72</div>
    <div class="label">72 задания</div>
  </div>
  <div class="stat">
    <div class="label">Общий прогресс</div>
    <div class="value" data-global-pct>0%</div>
    <div
      class="progress"
      role="progressbar"
      aria-label="Общий прогресс обучения"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      aria-valuetext="0%"
      data-global-progress
    >
      <span data-global-fill style="transform: scaleX(0)"></span>
    </div>
  </div>
</div>
