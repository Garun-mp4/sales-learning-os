---
import icons from '../lib/icons.json';
interface Props { name: string; size?: number }
const {name,size=16}=Astro.props;
if(!Object.hasOwn(icons,name))throw new Error(`Unknown UI icon: ${name}`);
const paths=icons[name as keyof typeof icons];
---
<svg class="icon" data-icon={name} width={size} height={size} style={`--icon-size:${size}px`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={paths}/>
